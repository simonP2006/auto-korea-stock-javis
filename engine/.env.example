# 키움증권 REST API 인증 (조회 전용)
# ⚠️ 이 파일은 견본입니다 — 실제 키를 절대 기입하지 마십시오.
#    실제 키는 이 파일을 .env 로 복사한 뒤 .env 에만 기입합니다 (.env 는 git에 올라가지 않음).
#    사용법: cp .env.example .env  →  .env 열어서 발급받은 키로 교체
KIWOOM_APP_KEY=your_kiwoom_app_key_here
KIWOOM_SECRET_KEY=your_kiwoom_secret_key_here

# 운영 모드: real (실전 시세, 분석에 사용) / mock (모의 시세, 테스트용)
# 분석 목적이면 real 권장 (모의투자 시세는 일부 종목 누락/지연 있음)
KIWOOM_MODE=real

# 로그 레벨
LOG_LEVEL=INFO

# 분석 결과 출력 경로
REPORT_OUTPUT_DIR=./reports
